    "/api/v3/directory/graph/{object_type}/{relation}/{subject_type}": {
      "get": {
        "description": "Returns object graph from anchor to subject or object.",
        "operationId": "directory.reader.v3.graph",
        "parameters": [
          {
            "description": "object type identifier",
            "in": "path",
            "name": "object_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "relation name",
            "in": "path",
            "name": "relation",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "subject type identifier",
            "in": "path",
            "name": "subject_type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "object instance identifier (optional)",
            "in": "query",
            "name": "object_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "subject instance identifier (optional)",
            "in": "query",
            "name": "subject_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "subject relation name (optional)",
            "in": "query",
            "name": "subject_relation",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "return graph paths for each result (optional)",
            "in": "query",
            "name": "explain",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "collect trace information (optional)",
            "in": "query",
            "name": "trace",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
